{
  "name": "artisvn",
  "version": "2.3.1",
  "description": "SVN Desktop Client - Cliente SVN estilo GitHub Desktop",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/run-electron-vite.mjs dev",
    "build:mcp-bridge": "node scripts/build-mcp-bridge.mjs --sea",
    "build:mcp-bridge:bundle": "node scripts/build-mcp-bridge.mjs",
    "build": "node scripts/bundle-svn.mjs && electron-vite build && npm run build:mcp-bridge",
    "start": "node scripts/run-electron-vite.mjs preview",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "check": "npm run typecheck && npm test",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "release": "npm run build"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "docx-preview": "0.3.7",
    "electron-store": "^8.2.0",
    "jszip": "^3.10.1",
    "pdfjs-dist": "4.10.38",
    "xml2js": "^0.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/xml2js": "^0.4.14",
    "@vitejs/plugin-react": "^4.3.0",
    "cross-env": "^7.0.3",
    "electron": "44.10.0",
    "electron-builder": "^24.13.0",
    "electron-vite": "^5.0.0",
    "postject": "^1.0.0-alpha.6",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsx": "^4.22.1",
    "typescript": "^5.5.0",
    "vite": "^5.3.0"
  },
  "build": {
    "appId": "com.artisvn.app",
    "productName": "ArtiSVN",
    "mac": {
      "target": "dmg",
      "icon": "resources/icon.icns",
      "artifactName": "${productName}-Mac-${version}-Installer.${ext}",
      "extraResources": [
        {
          "from": "dist-mcp-bridge/bridge.cjs",
          "to": "bridge/bridge.cjs"
        },
        {
          "from": "dist-mcp-bridge/artisvn-mcp-bridge",
          "to": "bridge/artisvn-mcp-bridge"
        },
        {
          "from": "dist-mcp-bridge/javisvn-mcp-bridge",
          "to": "bridge/javisvn-mcp-bridge"
        }
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico",
      "artifactName": "${productName}-Windows-${version}-Setup.${ext}",
      "extraFiles": [
        {
          "from": "dist-mcp-bridge/ArtiSvnMcp.exe",
          "to": "ArtiSvnMcp.exe"
        },
        {
          "from": "dist-mcp-bridge/JaviSvnMcp.exe",
          "to": "JaviSvnMcp.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 360,
          "type": "file",
          "path": "resources/LEER_ANTES_DE_ABRIR.txt"
        }
      ]
    },
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/lib",
        "to": "lib",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/LEER_ANTES_DE_ABRIR.txt",
        "to": "LEER_ANTES_DE_ABRIR.txt"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://storage.googleapis.com/artictools-releases/artisvn/releases"
      }
    ],
    "files": [
      "out/**/*",
      "package.json"
    ]
  }
}
